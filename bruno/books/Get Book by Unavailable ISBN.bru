meta {
  name: Get Book by Unavailable ISBN
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/BookStore/v1/Book?ISBN={{unavailableIsbn}}
  body: none
  auth: inherit
}

params:query {
  ISBN: {{unavailableIsbn}}
}

assert {
  res.status: eq 400
  res.headers['content-type']: contains application/json
  res.body.code: isString
  res.body.message: eq ISBN supplied is not available in Books Collection!
}

tests {
  test("unavailable ISBN error should match the expected contract", function () {
    const responseBody = res.getBody();

    expect(responseBody).to.have.all.keys(
      "code",
      "message",
    );

    expect(responseBody.code).to.be.a("string");
    expect(responseBody.code).to.equal("1205");

    expect(responseBody.message).to.be.a("string").and.not.be.empty;
    expect(responseBody.message).to.equal(
      "ISBN supplied is not available in Books Collection!",
    );
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
