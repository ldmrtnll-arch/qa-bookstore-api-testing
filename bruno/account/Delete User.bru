meta {
  name: Delete User
  type: http
  seq: 3
}

delete {
  url: {{baseUrl}}/Account/v1/User/{{userId}}
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{authToken}}
  Accept: application/json
}

assert {
  res.status: eq 204
}

tests {
  test("successful user deletion should return an empty body", function () {
    const responseBody = res.getBody();

    expect(responseBody).to.equal("");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
